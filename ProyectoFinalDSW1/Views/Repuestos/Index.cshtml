@model ListaPaginada<Repuesto>
@{
    ViewData["Title"] = "Repuestos";
    var soloAlerta = ViewBag.SoloAlerta == true;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Repuestos @(soloAlerta ? "en alerta de stock" : "")</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo repuesto</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por nombre" maxlength="100" />
    </div>
    <div class="col-auto d-flex align-items-center">
        <div class="form-check me-3">
            <input class="form-check-input" type="checkbox" name="alerta" value="true" id="alerta" checked="@soloAlerta" />
            <label class="form-check-label" for="alerta">Solo stock mínimo</label>
        </div>
        <button type="submit" class="btn btn-outline-primary me-1">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Stock mínimo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>S/ @item.Precio.ToString("N2")</td>
                        <td>
                            @if (item.Stock <= item.StockMinimo)
                            {
                                <span class="badge bg-danger" title="Llegó al stock mínimo">@item.Stock</span>
                            }
                            else
                            {
                                <span>@item.Stock</span>
                            }
                        </td>
                        <td>@item.StockMinimo</td>
                        <td>
                            <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span>
                        </td>
                        <td><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted">No hay repuestos para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model" />
