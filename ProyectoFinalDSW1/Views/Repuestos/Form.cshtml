@model Repuesto
@{
    var esNuevo = Model.Id == 0;
    ViewData["Title"] = esNuevo ? "Nuevo repuesto" : "Editar repuesto";
}

<h2>@ViewData["Title"]</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="@(esNuevo ? "Create" : "Edit")" asp-route-id="@Model.Id" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (!esNuevo)
            {
                <input type="hidden" asp-for="Id" />
            }

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" class="form-control" type="text" inputmode="decimal" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Stock" class="form-label"></label>
                    <input asp-for="Stock" class="form-control" />
                    <span asp-validation-for="Stock" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="StockMinimo" class="form-label"></label>
                    <input asp-for="StockMinimo" class="form-control" />
                    <span asp-validation-for="StockMinimo" class="text-danger"></span>
                </div>
            </div>
            <div class="form-check mb-3">
                <input asp-for="Activo" class="form-check-input" />
                <label asp-for="Activo" class="form-check-label">Repuesto activo</label>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
