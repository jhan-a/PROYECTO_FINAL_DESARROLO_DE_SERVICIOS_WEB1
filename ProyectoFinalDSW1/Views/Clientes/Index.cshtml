@model ListaPaginada<Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Clientes</h2>
    <a class="btn btn-primary" asp-action="Create">Nuevo cliente</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por nombre, DNI o correo" maxlength="100" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>DNI</th>
                <th>Teléfono</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Nombre</td>
                        <td>@item.Dni</td>
                        <td>@item.Telefono</td>
                        <td>@item.Correo</td>
                        <td>
                            <span class="badge @(item.Activo ? "bg-success" : "bg-secondary")">@(item.Activo ? "Activo" : "Inactivo")</span>
                        </td>
                        <td><a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="6" class="text-center text-muted">No hay clientes registrados.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model" />
