@model ListaPaginada<Vehiculo>
@{
    ViewData["Title"] = "Vehículos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Vehículos</h2>
    <a class="btn btn-primary" asp-action="Create">Registrar vehículo</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por placa, marca, modelo o cliente" maxlength="100" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Placa</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Año</th>
                <th>Kilometraje</th>
                <th>Cliente</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    var confirmaOrden = $"¿Crear una nueva orden para {item.Placa}?";
                    var confirmaBorrar = $"¿Eliminar el vehículo {item.Placa}?";
                    <tr>
                        <td>@item.Placa</td>
                        <td>@item.Marca</td>
                        <td>@item.Modelo</td>
                        <td>@item.Anio</td>
                        <td>@item.Kilometraje.ToString("N0") km</td>
                        <td>@item.Cliente?.Nombre</td>
                        <td class="acciones">
                            <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                            <form asp-action="NuevaOrden" asp-route-id="@item.Id" method="post"
                                  data-confirmar="@confirmaOrden">
                                <button type="submit" class="btn btn-sm btn-success">Nueva orden</button>
                            </form>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post"
                                  data-confirmar="@confirmaBorrar">
                                <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="7" class="text-center text-muted">No hay vehículos registrados.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model" />
