@model OrdenTrabajo
@{
    ViewData["Title"] = "Orden N° " + Model.Id;
    var esAdmin = User.IsInRole("Admin");
    var editable = Model.Estado == EstadoOrden.EnReparacion;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Orden N° @Model.Id <span class="badge @Model.Estado.Clase()">@Model.Estado.Texto()</span></h2>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver a la lista</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Vehículo y cliente</div>
            <div class="card-body">
                <p class="mb-1"><strong>Placa:</strong> @Model.Vehiculo?.Placa</p>
                <p class="mb-1"><strong>Vehículo:</strong> @Model.Vehiculo?.Marca @Model.Vehiculo?.Modelo (@Model.Vehiculo?.Anio)</p>
                <p class="mb-1"><strong>Kilometraje:</strong> @Model.Vehiculo?.Kilometraje.ToString("N0") km</p>
                <p class="mb-1"><strong>Cliente:</strong> @Model.Vehiculo?.Cliente?.Nombre</p>
                <p class="mb-0"><strong>Teléfono:</strong> @Model.Vehiculo?.Cliente?.Telefono</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Seguimiento</div>
            <div class="card-body">
                <p class="mb-1"><strong>Ingreso:</strong> @Model.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</p>
                <p class="mb-1"><strong>Entrega:</strong> @(Model.FechaEntrega?.ToString("dd/MM/yyyy HH:mm") ?? "Aún no entregado")</p>
                <p class="mb-1"><strong>Mecánico:</strong> @(Model.Mecanico?.Nombre ?? "Sin asignar")</p>
                <p class="mb-3"><strong>Costo total:</strong> <span class="fs-5">S/ @Model.CostoTotal.ToString("N2")</span></p>

                @if (esAdmin && Model.Estado != EstadoOrden.Entregado)
                {
                    <form asp-action="Asignar" asp-route-id="@Model.Id" method="post" class="row g-2 mb-3">
                        <div class="col">
                            <select name="mecanicoId" asp-items="(SelectList)ViewBag.Mecanicos" class="form-select form-select-sm">
                                <option value="">Seleccione un mecánico...</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-sm btn-primary">Asignar</button>
                        </div>
                    </form>
                }

                @if (Model.Estado == EstadoOrden.Pendiente)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post">
                        <input type="hidden" name="nuevoEstado" value="@((int)EstadoOrden.EnReparacion)" />
                        <button type="submit" class="btn btn-warning">Iniciar reparación</button>
                    </form>
                }
                else if (Model.Estado == EstadoOrden.EnReparacion)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post"
                          data-confirmar="¿Marcar la orden como terminada? Ya no podrás agregar servicios ni repuestos.">
                        <input type="hidden" name="nuevoEstado" value="@((int)EstadoOrden.Terminado)" />
                        <button type="submit" class="btn btn-info">Marcar como terminada</button>
                    </form>
                }
                else if (Model.Estado == EstadoOrden.Terminado && esAdmin)
                {
                    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post"
                          data-confirmar="¿Confirmar la entrega del vehículo al cliente?">
                        <input type="hidden" name="nuevoEstado" value="@((int)EstadoOrden.Entregado)" />
                        <button type="submit" class="btn btn-success">Entregar vehículo</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<h4>Servicios y repuestos</h4>
<div class="table-responsive mb-3">
    <table class="table table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th>Tipo</th>
                <th>Descripción</th>
                <th class="text-end">Cantidad</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Detalles.Any())
            {
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@(d.ServicioId != null ? "Servicio" : "Repuesto")</td>
                        <td>@(d.Servicio?.Nombre ?? d.Repuesto?.Nombre)</td>
                        <td class="text-end">@d.Cantidad</td>
                        <td class="text-end">S/ @d.Subtotal.ToString("N2")</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center text-muted">Todavía no se agregaron servicios ni repuestos.</td></tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Total</th>
                <th class="text-end">S/ @Model.CostoTotal.ToString("N2")</th>
            </tr>
        </tfoot>
    </table>
</div>

@if (editable)
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Agregar servicio</div>
                <div class="card-body">
                    <form asp-action="AgregarServicio" asp-route-id="@Model.Id" method="post" class="row g-2">
                        <div class="col">
                            <select name="servicioId" asp-items="(SelectList)ViewBag.Servicios" class="form-select">
                                <option value="">Seleccione un servicio...</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Agregar repuesto</div>
                <div class="card-body">
                    <form asp-action="AgregarRepuesto" asp-route-id="@Model.Id" method="post" class="row g-2">
                        <div class="col-12 col-lg">
                            <select name="repuestoId" asp-items="(SelectList)ViewBag.Repuestos" class="form-select">
                                <option value="">Seleccione un repuesto...</option>
                            </select>
                        </div>
                        <div class="col-6 col-lg-3">
                            <input type="number" name="cantidad" value="1" min="1" max="1000" class="form-control" aria-label="Cantidad" />
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary">Agregar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
