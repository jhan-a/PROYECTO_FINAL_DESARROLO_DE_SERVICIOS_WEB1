@model ListaPaginada<OrdenTrabajo>
@{
    var esAdmin = User.IsInRole("Admin");
    ViewData["Title"] = esAdmin ? "Órdenes de trabajo" : "Mis órdenes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@ViewData["Title"]</h2>
    @if (esAdmin)
    {
        <a class="btn btn-primary" asp-controller="Vehiculos" asp-action="Create">Registrar vehículo</a>
    }
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="buscar" value="@Model.Buscar" class="form-control" placeholder="Buscar por placa o cliente" maxlength="100" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select asp-for="Estado" asp-items="Html.GetEnumSelectList<EstadoOrden>()" class="form-select">
            <option value="">Todos los estados</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>N°</th>
                <th>Ingreso</th>
                <th>Vehículo</th>
                <th>Cliente</th>
                <th>Mecánico</th>
                <th>Estado</th>
                <th>Costo total</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Any())
            {
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Vehiculo?.Placa <small class="text-muted">@item.Vehiculo?.Marca @item.Vehiculo?.Modelo</small></td>
                        <td>@item.Vehiculo?.Cliente?.Nombre</td>
                        <td>@(item.Mecanico?.Nombre ?? "Sin asignar")</td>
                        <td><span class="badge @item.Estado.Clase()">@item.Estado.Texto()</span></td>
                        <td>S/ @item.CostoTotal.ToString("N2")</td>
                        <td><a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id">Ver detalle</a></td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="8" class="text-center text-muted">No hay órdenes para mostrar.</td></tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Paginacion" model="Model" />
