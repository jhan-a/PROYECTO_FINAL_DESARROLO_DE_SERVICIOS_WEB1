@model UsuarioCrearViewModel
@{
    ViewData["Title"] = "Nuevo usuario";
}

<h2>Nuevo usuario</h2>
<hr />
<div class="row">
    <div class="col-md-5">
        <form asp-action="Create" method="post" autocomplete="off">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Rol" class="form-label"></label>
                <select asp-for="Rol" asp-items="Html.GetEnumSelectList<Rol>()" class="form-select">
                    <option value="">Seleccione...</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Clave" class="form-label"></label>
                <input asp-for="Clave" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Clave" class="text-danger"></span>
                <div class="form-text">Mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmarClave" class="form-label"></label>
                <input asp-for="ConfirmarClave" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarClave" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
